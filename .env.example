# Optional LLM candidate extraction (only needed with --enable-extraction)
# MODEL_API_KEY=your-api-key-here
# MODEL_BASE_URL=https://api.your-provider.example/v1
# MODEL_NAME=your-model

# Optional Agent HTTP bridge settings (only needed when connecting MCP over loopback HTTP instead of local workspace mode)
# PROJECT_COMPASS_BASE_URL=http://127.0.0.1:8787
# PROJECT_COMPASS_AGENT_TOKEN=replace-with-local-random-token-32plus-chars

# Deterministic sample mode & logging
SAMPLE_MODE=false
LOG_LEVEL=INFO
